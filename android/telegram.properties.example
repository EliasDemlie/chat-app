# Copy to android/telegram.properties (gitignored) and fill in.
# Alternatively set the TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID environment variables.
# Leave empty to disable Telegram backup.

# Token from @BotFather.
telegram.botToken=

# Channel ID, e.g. -1001234567890, or @channel_username for public channels.
# The bot must be an administrator of the channel with permission to post.
telegram.chatId=
